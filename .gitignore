.pytest-local-tmp/
artifacts/

# Local models (but not the backend's own models/ Python source package,
# and not the small placeholder .gguf fixtures used by backend tests).
# NOTE: this pattern matches ANY directory literally named "models" at any
# depth. If you add a new fixture/package with such a directory whose
# contents should be tracked, add a `!path/to/it/models/` negation here —
# otherwise files silently never get committed (this already happened once,
# see the runtime-chat-tuning-lab negation below and scripts/check-fixture-
# completeness.mjs, which would now catch a recurrence).
models/
!backend/app/models/
!test-fixtures/runtime-chat-tuning-lab/models/

# Local workspace / dev data
apps/desktop/electron-data/
apps/desktop/playwright-report/
apps/desktop/test-results/
codee-run-run-*.json
debug/*.png

# Große Binärarchive gehören nicht ins Git-Repo (bläht Historie auf).
# Hinweis: Bereits getrackte Zips müssen zusätzlich per `git rm --cached <datei>.zip`
# im echten Repo entfernt werden - das kann diese Datei-Bereinigung allein nicht leisten.
*.zip
