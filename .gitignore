__pycache__/
*.py[cod]
.pytest_cache/
backend/tests/.pytest-local-tmp/
backend/tests/.pytest-basetemp/
.venv/
venv/
*.egg-info/

# Node / frontend
node_modules/
dist/
dist-release/
build/
out/
.next/
coverage/

# Packaging artifacts
backend-dist/
backend/build-work/

# Logs and local runtime data
*.log
logs/
tmp/
temp/

# IDE / OS
.idea/
.vscode/
.vs/

# App runtime data (restore points, telemetry)
**/.codee/
*.swp
Thumbs.db
dev-trace-*.log

.pytest-local-tmp/
artifacts/

# Local models (but not the backend's own models/ Python source package)
models/
!backend/app/models/

# Local workspace / dev data
apps/desktop/electron-data/
codee-run-run-*.json

# Root workspace runtime data is intentionally versioned for Skill Runtime V1.
!/.codee/
!/.codee/**
/.codee/functiongemma/*.gguf

# Große Binärarchive gehören nicht ins Git-Repo (bläht Historie auf).
# Hinweis: Bereits getrackte Zips müssen zusätzlich per `git rm --cached <datei>.zip`
# im echten Repo entfernt werden - das kann diese Datei-Bereinigung allein nicht leisten.
*.zip
