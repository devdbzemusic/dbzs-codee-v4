<Window
    x:Class="DBZS.Codee.ModelOps.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DBZS Codee Model Operations Center">

    <Grid x:Name="RootView" Background="{StaticResource DbzsBackgroundBrush}">
        <NavigationView
            x:Name="ShellNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" Tag="dashboard" IsSelected="True" />
                <NavigationViewItem Content="Model Library" Icon="Library" Tag="library" />
                <NavigationViewItem Content="Scanner" Icon="Find" Tag="scanner" />
                <NavigationViewItem Content="Inspector" Icon="Document" Tag="inspector" />
                <NavigationViewItem Content="Settings" Icon="Setting" Tag="settings" />
            </NavigationView.MenuItems>
            <Grid Padding="24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DBZS Codee Model Operations Center" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid x:Name="DashboardView" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Modelle" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                    <TextBlock Text="{Binding ModelCount}" FontSize="30" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Quellen" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                    <TextBlock Text="{Binding SourceCount}" FontSize="30" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Jobs" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                    <TextBlock Text="{Binding JobCount}" FontSize="30" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Runtime" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                    <TextBlock Text="{Binding Hardware.RuntimeBackend}" FontSize="30" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding HardwareSummary}" FontSize="16" Foreground="{StaticResource DbzsTextMutedBrush}" />
                    </Grid>

                    <Grid x:Name="LibraryView" Visibility="Collapsed">
                        <ListView ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                    <TextBlock Text="{Binding Bundle.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Bundle.BundleId}" Foreground="{StaticResource DbzsTextMutedBrush}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Bundle.Status}" />
                                        <TextBlock Grid.Column="2" Text="{Binding PrimaryFormat}" />
                                        <TextBlock Grid.Column="3" Text="{Binding CapabilitySummary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="ScannerView" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Modellquelle" Text="{Binding NewSourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="D:\Models" />
                            <Button Grid.Column="1" Command="{Binding AddSourceCommand}" VerticalAlignment="Bottom" Content="Quelle speichern" />
                            <Button Grid.Column="2" Command="{Binding ScanCommand}" VerticalAlignment="Bottom" Content="Scan starten" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding ScanStatusText}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                        <ListView Grid.Row="2" ItemsSource="{Binding Sources}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LastScanStatus}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="InspectorView" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding SelectedModel.Bundle.Name}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedModel.Bundle.Status}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedModel.CapabilitySummary}" />
                            <ListView ItemsSource="{Binding SelectedModel.Artifacts}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ArtifactType}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SettingsView" Visibility="Collapsed">
                        <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                            <TextBox Header="Codee Backend URL" Text="{Binding BackendUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Secrets und API Tokens werden nicht in dieser App gespeichert." Foreground="{StaticResource DbzsTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
