<Window
    x:Class="DBZS.Codee.ModelOps.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DBZS Codee Model Operations Center">

    <Grid
        x:Name="RootView"
        Background="{StaticResource DbzsBackgroundBrush}"
        RequestedTheme="Dark"
        Loaded="OnRootViewLoaded">
        <NavigationView
            x:Name="ShellNavigation"
            Background="{StaticResource DbzsBackgroundBrush}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DashboardNavItem" Content="Dashboard" Icon="Home" Tag="dashboard" IsSelected="True" />
                <NavigationViewItem x:Name="LibraryNavItem" Content="Model Library" Icon="Library" Tag="library" />
                <NavigationViewItem Content="Scanner" Icon="Find" Tag="scanner" />
                <NavigationViewItem Content="Inspector" Icon="Document" Tag="inspector" />
                <NavigationViewItem Content="Settings" Icon="Setting" Tag="settings" />
            </NavigationView.MenuItems>
            <Grid Padding="24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DBZS Codee Model Operations Center" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid x:Name="DashboardView" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Modelle" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                    <TextBlock Text="{Binding ModelCount}" FontSize="30" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Quellen" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                    <TextBlock Text="{Binding SourceCount}" FontSize="30" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Jobs" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                    <TextBlock Text="{Binding JobCount}" FontSize="30" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Runtime" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                    <TextBlock Text="{Binding Hardware.RuntimeBackend}" FontSize="30" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock Text="{Binding HardwareSummary}" FontSize="16" Foreground="{StaticResource DbzsTextMutedBrush}" />
                            <TextBlock Text="{Binding CollectionSummary}" FontSize="16" Foreground="{StaticResource DbzsTextMutedBrush}" />
                            <TextBlock Text="{Binding LatestScanSummary}" FontSize="16" Foreground="{StaticResource DbzsTextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LibraryView" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Filter" Text="{Binding ModelFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name, Typ, Capability, Tag" />
                            <TextBox Grid.Column="1" Header="Health" Text="{Binding HealthFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="healthy, incomplete" />
                            <CheckBox Grid.Column="2" Content="Favoriten" IsChecked="{Binding FavoritesOnly, Mode=TwoWay}" VerticalAlignment="Bottom" />
                            <Button Grid.Column="3" Command="{Binding ClearModelFiltersCommand}" VerticalAlignment="Bottom" Content="Filter zurücksetzen" />
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="{Binding ModelLibrarySummary}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                            <TextBlock Text="{Binding ModelLibraryHint}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                        </StackPanel>
                        <ListView Grid.Row="2" ItemsSource="{Binding FilteredModels}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Bundle.Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Bundle.BundleId}" Foreground="{StaticResource DbzsTextMutedBrush}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Bundle.Status}" />
                                        <TextBlock Grid.Column="2" Text="{Binding PrimaryFormat}" />
                                        <TextBlock Grid.Column="3" Text="{Binding HealthSummary}" />
                                        <TextBlock Grid.Column="4" Text="{Binding TagSummary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="ScannerView" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Modellquelle" Text="{Binding NewSourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="D:\Models" />
                            <Button Grid.Column="1" Command="{Binding AddSourceCommand}" VerticalAlignment="Bottom" Content="Quelle speichern" />
                            <Button Grid.Column="2" Command="{Binding ScanCommand}" VerticalAlignment="Bottom" Content="Scan starten" />
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="{Binding ScanStatusText}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                            <TextBlock Text="{Binding LatestScanSummary}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedSource.Path}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                        </StackPanel>
                        <ListView Grid.Row="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LastScanStatus}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="InspectorView" Visibility="Collapsed">
                        <StackPanel Spacing="10" MaxWidth="920" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedModel.Bundle.Name}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedModel.Bundle.Status}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedModel.CapabilitySummary}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Health" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedModel.Bundle.Health.Status}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedModel.Bundle.Health.ModelType}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Architektur" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedModel.Bundle.Health.Architecture}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedContextSummary}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Quantisierung" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedModel.Bundle.Health.Quantization}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedModel.PrimaryFormat}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding SelectedModel.MissingSummary}" Foreground="{StaticResource DbzsTextMutedBrush}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Tags" Text="{Binding SelectedTagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="coding, favorite, low-vram" />
                                <CheckBox Grid.Column="1" Content="Favorit" IsChecked="{Binding SelectedIsFavorite, Mode=TwoWay}" VerticalAlignment="Bottom" />
                            </Grid>
                            <TextBox Header="Notizen" Text="{Binding SelectedNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="86" />
                            <Button Command="{Binding SaveSelectedMetadataCommand}" Content="Metadaten speichern" HorizontalAlignment="Left" />
                            <ListView ItemsSource="{Binding SelectedModel.Artifacts}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ArtifactType}" Foreground="{StaticResource DbzsTextMutedBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SettingsView" Visibility="Collapsed">
                        <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                            <TextBox Header="Codee Backend URL" Text="{Binding BackendUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Secrets und API Tokens werden nicht in dieser App gespeichert." Foreground="{StaticResource DbzsTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
        <Grid
            Background="#E6081018"
            Visibility="{Binding StartupOverlayVisibility}">
            <Border
                Width="520"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource DbzsPanelBrush}"
                BorderBrush="#27465A"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ProgressRing
                            Width="36"
                            Height="36"
                            IsActive="True" />
                        <StackPanel>
                            <TextBlock Text="DBZS Codee Model Operations Center" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Backend Start" Foreground="{StaticResource DbzsTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding StartupStatusText}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StartupDetailText}" Foreground="{StaticResource DbzsTextMutedBrush}" TextWrapping="Wrap" />
                    <Button Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Content="Erneut verbinden" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
