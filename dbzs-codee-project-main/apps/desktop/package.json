{
  "name": "@dbzs/desktop",
  "version": "0.4.0-rc.1",
  "private": true,
  "main": "out/main/main.js",
  "dependencies": {
    "@dbzs/shared": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:agent-web": "vitest run electron/webResearchService.test.ts",
    "test:chat-actions": "vitest run src/testing/chatActions.test.ts",
    "test:file-apply": "vitest run electron/agentPatchCoordinator.test.ts",
    "test:chat-file-apply": "vitest run electron/chatFileApply.integration.test.ts",
    "test:capabilities": "vitest run src/testing/codingAssistant/capabilitySuite.test.ts",
    "test:capabilities:live": "vitest run src/testing/codingAssistant/liveRuntimeProbe.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons:generate": "node scripts/generate-icons.mjs",
    "release:win": "electron-vite build && electron-builder --win",
    "release:mac": "electron-vite build && electron-builder --mac",
    "release:linux": "electron-vite build && electron-builder --linux",
    "release:all": "electron-vite build && electron-builder --win --mac --linux",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "dev:renderer": "node scripts/dev-renderer.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "electron": "^42.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
