From 86e3b5ab4fe9391383531138faf52d8553346917 Mon Sep 17 00:00:00 2001
From: Ralf <dbz.emusic@gmail.com>
Date: Sat, 27 Jun 2026 02:10:42 +0200
Subject: [PATCH 05/12] fix(runtime): validate model against slot

- Add model-slot consistency check in resolve_chat_target()
- Reject requests when requested model_id doesn't match running model
- Raise RuntimeError('selected_model_not_running_in_slot...') on mismatch
- Prevent frontend sending requests to wrong slot/model combination

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 backend/app/runtime/service.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/backend/app/runtime/service.py b/backend/app/runtime/service.py
index 5cb89f2..ccb2649 100644
--- a/backend/app/runtime/service.py
+++ b/backend/app/runtime/service.py
@@ -632,6 +632,15 @@ class RuntimeService:
     def resolve_chat_target(self, chat_request: RuntimeChatRequest) -> RuntimeStreamContext:
         slot_id = chat_request.slot_id or self._route_request_slot(chat_request)
         current = self.status_for_slot(slot_id)
+        
+        # Validate model-slot consistency: if model_id is specified, it must match
+        if chat_request.model_id and current.model_id != chat_request.model_id:
+            raise RuntimeError(
+                f"selected_model_not_running_in_slot: "
+                f"requested model '{chat_request.model_id}' but slot '{slot_id}' "
+                f"has '{current.model_id}'"
+            )
+        
         if current.state == "running" and current.endpoint:
             return RuntimeStreamContext(
                 slot_id=slot_id,
