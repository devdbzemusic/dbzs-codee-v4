Date: Sat, 27 Jun 2026 02:10:33 +0200
Subject: [PATCH 03/12] fix(routing): create broker decision in store

- Import brokerDecision and classifyTaskType from modelSelectionBroker
- Call classifyTaskType() on user message to determine task type
- Create broker decision directly in store before context build
- Store decision in lastRouting for diagnostics and validation
- Eliminate async delegation to agentRunService

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 apps/desktop/src/stores/runtimeChatStore.ts | 89 +++++++++++++++++++--
 1 file changed, 84 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/stores/runtimeChatStore.ts b/apps/desktop/src/stores/runtimeChatStore.ts
index 18588a8..0b30255 100644
--- a/apps/desktop/src/stores/runtimeChatStore.ts
+++ b/apps/desktop/src/stores/runtimeChatStore.ts
@@ -69,6 +69,8 @@ import {
 } from "@/services/runtimeChatObservability";
 import { DEFAULT_TIMEOUTS, selectTimeoutProfile, TimeoutManager } from "@/services/timeoutConfig";
 import { classifyRuntimeChatError, formatChatErrorForUser } from "@/services/runtimeChatErrorClassifier";
+import { classifyTaskType, brokerDecision } from "@/services/modelSelectionBroker";
+import { verifySlotForRequest } from "@/services/runtimeSlotValidator";
 
 const MAX_CONTEXT_CHARS = 16_000;
 const MAX_HISTORY_MESSAGES = 12;
@@ -608,12 +610,28 @@ export const useRuntimeChatStore = create<RuntimeChatState>((set, get) => ({
     updateActiveRun((r) => appendRunEvent(updateRunStatus(r, "routing"), "routing.started", "Modell-Routing"));
     let routing;
     try {
-      routing = await withTimeout(
-        agentRunService.resolveRouting(effectiveAgent),
-        timeoutManager.getRouting(),
-        "Modell-Routing",
-        runAbortController.signal
+      // Create broker decision directly in store
+      const taskType = classifyTaskType(
+        trimmedContent,
+        effectiveAgent !== "runtime_chat",
+        !!activeFile?.content
       );
+      const settings = useSettingsStore.getState().settings;
+      const decision = brokerDecision(taskType, {
+        defaultModelId: settings.defaultModelId || "default",
+        defaultModelName: settings.defaultModelName || "Default Model",
+        defaultCoderModelId: settings.defaultCoderModelId,
+        defaultDebugModelId: settings.defaultDebugModelId,
+        localOnlyModels: settings.modelDiscoveryMode === "project_local_strict"
+      });
+      
+      routing = {
+        targetAgent: decision.targetAgent,
+        modelId: decision.modelId,
+        modelName: decision.modelName,
+        providerId: decision.providerId === "llama-cpp" ? "llama-cpp" : null,
+        slotId: decision.slotId
+      };
     } catch (error) {
       const errMsg = error instanceof Error ? error.message : "Routing fehlgeschlagen";
       failStep("model-route", "Modell-Routing", errMsg);
@@ -660,6 +678,67 @@ export const useRuntimeChatStore = create<RuntimeChatState>((set, get) => ({
       };
     });
 
+    // Validate that the target slot is ready for the requested model
+    if (routing.slotId && routing.modelId) {
+      beginStep("slot-validation", "Slot-Validierung");
+      try {
+        const backendUrl = useSettingsStore.getState().settings.backendUrl || "http://localhost:8000";
+        const validation = await verifySlotForRequest(
+          backendUrl,
+          routing.slotId as any,
+          routing.modelId,
+          5000
+        );
+        
+        if (!validation.ok) {
+          const errMsg = validation.error || "Slot validation failed";
+          failStep("slot-validation", "Slot-Validierung", errMsg);
+          updateActiveRun((r) => appendRunEvent(updateRunStatus(r, "failed"), "chat.failed", errMsg));
+          updateActivity(
+            patchActivityRun(activity, {
+              finishedAt: new Date().toISOString(),
+              summary: `Abgebrochen: ${errMsg}`
+            })
+          );
+          const finishedRun = get().activeRun;
+          resetFirstTokenTimeout();
+          clearTimeout(totalTimeout);
+          set((state) => ({
+            error: errMsg,
+            isSending: false,
+            lastActivity: activity,
+            currentActivity: null,
+            activeRun: null,
+            historicalRuns: finishedRun ? { ...state.historicalRuns, [finishedRun.id]: finishedRun } : state.historicalRuns
+          }));
+          return false;
+        }
+        finishStep("slot-validation", "Slot-Validierung", `Slot ${routing.slotId} validiert`);
+      } catch (error) {
+        const errMsg = error instanceof Error ? error.message : "Slot validation fehlgeschlagen";
+        failStep("slot-validation", "Slot-Validierung", errMsg);
+        updateActiveRun((r) => appendRunEvent(updateRunStatus(r, "failed"), "chat.failed", errMsg));
+        updateActivity(
+          patchActivityRun(activity, {
+            finishedAt: new Date().toISOString(),
+            summary: `Abgebrochen: ${errMsg}`
+          })
+        );
+        const finishedRun = get().activeRun;
+        resetFirstTokenTimeout();
+        clearTimeout(totalTimeout);
+        set((state) => ({
+          error: errMsg,
+          isSending: false,
+          lastActivity: activity,
+          currentActivity: null,
+          activeRun: null,
+          historicalRuns: finishedRun ? { ...state.historicalRuns, [finishedRun.id]: finishedRun } : state.historicalRuns
+        }));
+        return false;
+      }
+    }
+
     const orchestrationMessages: string[] = [];
   const memorySnippets: string[] = [];
 
