From 6aa95938ff34c226b0337292f825263fda9047b5 Mon Sep 17 00:00:00 2001
From: Ralf <dbz.emusic@gmail.com>
Date: Sat, 27 Jun 2026 02:11:26 +0200
Subject: [PATCH 08/12] fix(electron): bound non-stream chat requests

- Add signal parameter to BackendBridge.sendRuntimeChat interface
- Pass signal through in backendClient implementation
- Update agentRunService.sendChat to forward signal to backend
- Enable cancellation for both streaming and non-streaming requests

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 apps/desktop/src/services/agentRunService.ts | 2 +-
 apps/desktop/src/services/backendClient.ts   | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/services/agentRunService.ts b/apps/desktop/src/services/agentRunService.ts
index 6712de9..9d75361 100644
--- a/apps/desktop/src/services/agentRunService.ts
+++ b/apps/desktop/src/services/agentRunService.ts
@@ -45,7 +45,7 @@ class AgentRunService {
   async sendChat(request: RuntimeChatRequest, signal?: AbortSignal): Promise<RuntimeChatResponse> {
     // Use model_id from request (set by broker decision in store)
     // No legacy routing logic - rely on broker decision
-    return backendClient.sendRuntimeChat(request);
+    return backendClient.sendRuntimeChat(request, signal);
   }
 
   async sendChatStream(
diff --git a/apps/desktop/src/services/backendClient.ts b/apps/desktop/src/services/backendClient.ts
index 813f0b1..7c697b6 100644
--- a/apps/desktop/src/services/backendClient.ts
+++ b/apps/desktop/src/services/backendClient.ts
@@ -90,7 +90,7 @@ export interface BackendBridge {
   dryRunRuntimeModel?: (payload: RuntimeDryRunRequest) => Promise<RuntimeDryRunResponse>;
   probeRuntimeModel?: (payload: RuntimeProbeRequest) => Promise<RuntimeProbeResponse>;
   getRuntimeLogs?: () => Promise<RuntimeLogsResponse>;
-  sendRuntimeChat: (request: RuntimeChatRequest) => Promise<RuntimeChatResponse>;
+  sendRuntimeChat: (request: RuntimeChatRequest, signal?: AbortSignal) => Promise<RuntimeChatResponse>;
   streamRuntimeChat?: (
     request: RuntimeChatRequest,
     onChunk: (payload: { delta: string; totalLength: number }) => void,
@@ -314,7 +314,7 @@ export const backendClient = {
     }
     return method();
   },
-  sendRuntimeChat: (request: RuntimeChatRequest) => bridge().sendRuntimeChat(request),
+  sendRuntimeChat: (request: RuntimeChatRequest, signal?: AbortSignal) => bridge().sendRuntimeChat(request, signal),
   streamRuntimeChat: (
     request: RuntimeChatRequest,
     onChunk: (payload: { delta: string; totalLength: number }) => void,
-- 
