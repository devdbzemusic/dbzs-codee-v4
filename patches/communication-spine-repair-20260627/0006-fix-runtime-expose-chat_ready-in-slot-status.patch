Date: Sat, 27 Jun 2026 02:10:47 +0200
Subject: [PATCH 06/12] fix(runtime): expose chat_ready in slot status

- Add chat_ready: bool = False field to RuntimeSlotStatus
- Calculate as: state=='running' && endpoint exists && endpoint available
- Gate frontend chat requests on chat_ready contract
- Enable frontend to verify slot readiness before sending request

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 backend/app/runtime/schemas.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/backend/app/runtime/schemas.py b/backend/app/runtime/schemas.py
index f5ea653..ab3c445 100644
--- a/backend/app/runtime/schemas.py
+++ b/backend/app/runtime/schemas.py
@@ -31,6 +31,7 @@ class RuntimeSlotStatus(RuntimeStatus):
     device_policy: Literal["gpu", "cpu", "auto"] = "auto"
     gpu_layers: int | None = None
     context_size: int | None = None
+    chat_ready: bool = False
 
 
 class RuntimeLogsResponse(BaseModel):
