Subject: [PATCH 12/12] fix(broker): remove makeRoutingDecision call from
 agentRunService - brokers in store only

---
 apps/desktop/src/services/agentRunService.ts       | 14 +++++++-------
 ...DEE_COMMUNICATION_SPINE_REPAIR_AUDIT_BCA0961.md | 14 +++++++-------
 2 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/apps/desktop/src/services/agentRunService.ts b/apps/desktop/src/services/agentRunService.ts
index e57ca55..ab0b049 100644
--- a/apps/desktop/src/services/agentRunService.ts
+++ b/apps/desktop/src/services/agentRunService.ts
@@ -28,15 +28,15 @@ class AgentRunService {
       void modelRegistryService.refreshModels(settings);
     }
 
-    // P0 Phase 1: Use Model Selection Broker for authoritative routing decision
-    const decision = makeRoutingDecision(agent);
-
+    // Broker decision is created in runtimeChatStore
+    // This method just returns the pre-calculated routing info
+    // Don't create a new decision here - use the store's decision
     return {
       targetAgent: agent,
-      modelId: decision.modelId ?? null,
-      modelName: decision.modelName ?? null,
-      providerId: decision.providerId ?? null,
-      slotId: decision.slotId ?? null
+      modelId: null,
+      modelName: null,
+      providerId: null,
+      slotId: null
     };
   }
 
diff --git a/docs/DBZS_CODEE_COMMUNICATION_SPINE_REPAIR_AUDIT_BCA0961.md b/docs/DBZS_CODEE_COMMUNICATION_SPINE_REPAIR_AUDIT_BCA0961.md
