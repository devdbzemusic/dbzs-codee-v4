+"""
+P1 Phase 4: Model Discovery Service
+
+Enforces model discovery policies:
+- project_local_strict: Only models from <project>/models (no Ollama, no cloud)
+- local_with_ollama: <project>/models + Ollama models
+- cloud_enabled: All sources (project local + Ollama + cloud APIs)
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Optional
+
+from app.core.config import get_models_dir, get_ollama_models_dir
+from app.models.schemas import IndexedModel
+from app.settings.models import ModelDiscoveryMode
+
+
+class ModelDiscoveryService:
+    """
+    Filters models based on discovery mode.
+    Enforces strict isolation in project_local_strict mode.
+    """
+
+    def __init__(
+        self,
+        mode: ModelDiscoveryMode = "project_local_strict",
+        models_dir: Optional[Path] = None,
+        ollama_models_dir: Optional[Path] = None,
+    ):
+        self.mode = mode
+        self.models_dir = models_dir or get_models_dir()
+        self.ollama_models_dir = ollama_models_dir or get_ollama_models_dir()
+
+    def filter_models(self, models: list[IndexedModel]) -> list[IndexedModel]:
+        """
+        Filter models based on discovery mode.
+        Returns only models that should be available in this mode.
+        """
+        if self.mode == "project_local_strict":
+            return self._filter_project_local_strict(models)
+        elif self.mode == "local_with_ollama":
+            return self._filter_local_with_ollama(models)
+        else:  # cloud_enabled
+            return models
+
+    def _filter_project_local_strict(self, models: list[IndexedModel]) -> list[IndexedModel]:
+        """
+        Only return models from <project>/models directory.
+        Reject: Ollama models, cloud models, external paths.
+        """
+        result = []
+        for model in models:
+            if self._is_project_local(model.path):
+                result.append(model)
+        return result
+
+    def _filter_local_with_ollama(self, models: list[IndexedModel]) -> list[IndexedModel]:
+        """
+        Return models from <project>/models and Ollama.
+        Reject: cloud models, other external sources.
+        """
+        result = []
+        for model in models:
+            if self._is_project_local(model.path) or self._is_ollama(model.path):
+                result.append(model)
+        return result
+
+    def _is_project_local(self, model_path: str) -> bool:
+        """Check if model is in <project>/models directory."""
+        try:
+            model_path_obj = Path(model_path).resolve()
+            models_dir = self.models_dir.resolve()
+            # Check if model path is under models directory
+            model_path_obj.relative_to(models_dir)
+            return True
+        except (ValueError, RuntimeError):
+            return False
+
+    def _is_ollama(self, model_path: str) -> bool:
+        """Check if model is in Ollama directory."""
+        try:
+            model_path_obj = Path(model_path).resolve()
+            ollama_dir = self.ollama_models_dir.resolve()
+            model_path_obj.relative_to(ollama_dir)
+            return True
+        except (ValueError, RuntimeError):
+            return False
+
+    def validate_model_path(self, model_path: str) -> bool:
+        """
+        Validate that model path is allowed in current discovery mode.
+        Returns True if path is valid, False otherwise.
+        """
+        if self.mode == "project_local_strict":
+            return self._is_project_local(model_path)
+        elif self.mode == "local_with_ollama":
+            return self._is_project_local(model_path) or self._is_ollama(model_path)
+        else:  # cloud_enabled
+            return True
+
+    def get_project_relative_id(self, model_path: str) -> Optional[str]:
+        """
+        Generate stable relative ID for a model.
+        Returns None if model is not project-local.
+
+        Example: /project/models/llm/qwen-7b-q8_0.gguf -> llm/qwen-7b-q8_0.gguf
+        """
+        try:
+            model_path_obj = Path(model_path).resolve()
+            models_dir = self.models_dir.resolve()
+            relative = model_path_obj.relative_to(models_dir)
+            return relative.as_posix().lower()
+        except (ValueError, RuntimeError):
+            return None
+
+    def is_project_local(self, raw_path: str) -> bool:
+        """Public wrapper for _is_project_local."""
+        return self._is_project_local(raw_path)
+
+    def require_project_local(self, raw_path: str) -> Path:
+        """
+        Assert that a model path is project-local, return as Path.
+        Raises ValueError if not project-local.
+        """
+        if not self._is_project_local(raw_path):
+            raise ValueError(
+                f"Model path '{raw_path}' is not project-local. "
+                f"Must be under {self.models_dir}"
+            )
+        return Path(raw_path).resolve()
+
+    def allows_ollama(self) -> bool:
+        """Check if current discovery mode allows Ollama models."""
+        return self.mode in ("local_with_ollama", "cloud_enabled")
+
+    def allows_cloud(self) -> bool:
+        """Check if current discovery mode allows cloud models."""
+        return self.mode == "cloud_enabled"
+
+
+def make_stable_model_id(model_path: str, models_dir: Optional[Path] = None) -> str:
+    """
+    Generate a stable relative model ID from a path.
+
+    P1 Phase 4 Requirement:
+    - Use relative path (relative_path.relative_to(models_dir).as_posix().lower())
+    - Never use absolute paths
+    - IDs remain stable across path changes (only relative path matters)
+
+    Example:
+      project_root = /home/user/dbzs-codee-project
+      models_dir = /home/user/dbzs-codee-project/models
+      model_path = /home/user/dbzs-codee-project/models/llm/qwen-7b-q8_0.gguf
+      stable_id = "llm/qwen-7b-q8_0.gguf"
+    """
+    if models_dir is None:
+        models_dir = get_models_dir()
+
+    try:
+        model_path_obj = Path(model_path).resolve()
+        models_dir_obj = models_dir.resolve()
+        relative = model_path_obj.relative_to(models_dir_obj)
+        return relative.as_posix().lower()
+    except (ValueError, RuntimeError):
+        # Fallback: if model is not under models_dir, use filename
+        return Path(model_path).stem.lower()
